{
  "author": {
    "name": "David Herron",
    "email": "david@davidherron.com",
    "url": "http://davidherron.com"
  },
  "name": "akashacms-skeleton",
  "description": "AkashaCMS skeleton website",
  "repository": {
    "type": "git",
    "url": "git://github.com/akashacms/akashacms-skeleton.git"
  },
  "main": "config.mjs",
  "type": "module",
  "scripts": {
    "prebuild": "akasharender copy-assets config.mjs",
    "build": "akasharender render config.mjs",
    "deploy": "cd out && rsync --archive --delete --verbose ./ user-name@server-host.com:path-to-docroot/ ",
    "preview": "./node_modules/.bin/live-server out",
    "minify": "html-minifier --collapse-whitespace --conservative-collapse --html5 --keep-closing-slash --preserve-line-breaks --remove-comments --file-ext html  --input-dir out --output-dir out"
  },
  "dependencies": {
    "@akashacms/plugins-base": "akashacms/akashacms-base#0.9",
    "@akashacms/plugins-booknav": "akashacms/akashacms-booknav#0.9",
    "@akashacms/plugins-breadcrumbs": "akashacms/akashacms-breadcrumbs",
    "@akashacms/plugins-embeddables": "akashacms/akashacms-embeddables#0.9",
    "@akashacms/plugins-tagged-content": "akashacms/akashacms-tagged-content#0.9",
    "@akashacms/theme-bootstrap": "akashacms/akashacms-theme-bootstrap",
    "akasharender": "akashacms/akasharender#0.9",
    "bootstrap": "^4.6.x",
    "live-server": "^1.2.x",
    "html-minifier": "^3.1.1",
    "popper.js": ">=1.16.x",
    "jquery": "^3.6.x"
  }
}
